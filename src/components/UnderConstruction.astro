---
import { Image } from "astro:assets";
import chica2 from "../assets/chica2.jpg";
---

<div class="under-construction-overlay">
  <Image 
    src={chica2} 
    alt="Cosmopolitican Under Construction" 
    class="hero-image"
    loading="eager"
  />
</div>

<style>
  :global(body) {
    margin: 0;
    padding: 0;
    overflow: hidden; /* Block scrolling */
    height: 100vh;
    width: 100vw;
  }

  .under-construction-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: #000;
    overflow: hidden;
    z-index: 9999;
  }

  .hero-image {
    height: 100vh;
    width: auto;
    object-fit: contain;
  }
</style>

