---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import {
	getFigureClassNames,
	hasImageAttribution,
	type ArticleFigureAspect,
	type ArticleFigureVariant,
} from "@lib/imageMeta";
import { resolveRevistaImage } from "@lib/revistaImages";

interface Props {
	src: string | ImageMetadata;
	alt: string;
	caption?: string;
	credit?: string;
	license?: string;
	licenseUrl?: string;
	variant?: ArticleFigureVariant;
	aspect?: ArticleFigureAspect;
	width?: number;
	height?: number;
	loading?: "lazy" | "eager";
}

const {
	src,
	alt,
	caption,
	credit,
	license,
	licenseUrl,
	variant = "figura",
	aspect,
	width,
	height,
	loading = "lazy",
} = Astro.props;

const resolvedSrc = typeof src === "string" ? resolveRevistaImage(src) : src;
const figureClass = getFigureClassNames({ variant, aspect });
const showFigcaption = Boolean(caption || hasImageAttribution({ credit, license }));
---

<figure class={figureClass}>
	<Image
		src={resolvedSrc}
		alt={alt}
		width={width}
		height={height}
		loading={loading}
	/>
	{
		showFigcaption && (
			<figcaption>
				{caption && <span class="articulo__fig-caption">{caption}</span>}
				{
					hasImageAttribution({ credit, license }) && (
						<span class="articulo__fig-credit">
							{credit && <>Foto: {credit}</>}
							{license && licenseUrl && (
								<>
									{credit && " · "}
									<a href={licenseUrl} rel="license">{license}</a>
								</>
							)}
							{license && !licenseUrl && (
								<>
									{credit && " · "}
									{license}
								</>
							)}
						</span>
					)
				}
			</figcaption>
		)
	}
	<slot />
</figure>
