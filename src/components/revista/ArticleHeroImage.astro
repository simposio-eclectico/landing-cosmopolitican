---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import ArticleHeroCaption from "@components/revista/ArticleHeroCaption.astro";

interface Props {
	src: ImageMetadata;
	alt: string;
	caption?: string;
	credit?: string;
	license?: string;
	licenseUrl?: string;
	imagePosition?: "top" | "center" | "bottom";
}

const {
	src,
	alt,
	caption,
	credit,
	license,
	licenseUrl,
	imagePosition = "center",
} = Astro.props;
const HERO_IMAGE_WIDTH = 900;
const HERO_IMAGE_HEIGHT = 562;
---

<figure class="articulo__hero-imagen" style={`--articulo-hero-focal: ${imagePosition}`}>
	<Image src={src} alt={alt} width={HERO_IMAGE_WIDTH} height={HERO_IMAGE_HEIGHT} />
	<ArticleHeroCaption
		as="figcaption"
		caption={caption}
		credit={credit}
		license={license}
		licenseUrl={licenseUrl}
	/>
</figure>
