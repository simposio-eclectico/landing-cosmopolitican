---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import ArticleHeroCaption from "@components/revista/ArticleHeroCaption.astro";

interface Props {
	src: ImageMetadata;
	alt: string;
	caption?: string;
	credit?: string;
	license?: string;
	licenseUrl?: string;
}

const { src, alt, caption, credit, license, licenseUrl } = Astro.props;
---

<figure class="articulo__hero-imagen">
	<Image src={src} alt={alt} width={560} height={420} />
	<ArticleHeroCaption
		as="figcaption"
		caption={caption}
		credit={credit}
		license={license}
		licenseUrl={licenseUrl}
	/>
</figure>
