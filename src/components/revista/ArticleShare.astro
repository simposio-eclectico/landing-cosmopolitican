---
interface Props {
	url: string;
	title: string;
}

const { url, title } = Astro.props;

const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);

const links = [
	{
		name: "WhatsApp",
		href: `https://wa.me/?text=${encodedTitle}%20${encodedUrl}`,
	},
	{
		name: "X",
		href: `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`,
	},
	{
		name: "Telegram",
		href: `https://t.me/share/url?url=${encodedUrl}&text=${encodedTitle}`,
	},
	{
		name: "LinkedIn",
		href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
	},
	{
		name: "Facebook",
		href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
	},
	{
		name: "Email",
		href: `mailto:?subject=${encodedTitle}&body=${encodedUrl}`,
	},
];
---

<div class="compartir" data-share-url={url} data-share-title={title}>
	<button type="button" class="compartir__nativo" data-share-native hidden>
		<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
			<path
				d="M12 3v12m0-12 4 4m-4-4-4 4M6 13v6a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2v-6"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
			/>
		</svg>
		Compartir
	</button>

	<ul class="compartir__lista" data-share-fallback>
		{
			links.map((link) => (
				<li>
					<a
						class="compartir__enlace"
						href={link.href}
						target="_blank"
						rel="noopener noreferrer"
					>
						{link.name}
					</a>
				</li>
			))
		}
	</ul>
</div>

<script>
	document.querySelectorAll<HTMLElement>("[data-share-native]").forEach((button) => {
		if (!navigator.share) return;

		const container = button.closest<HTMLElement>(".compartir");
		if (!container) return;

		const fallback = container.querySelector<HTMLElement>("[data-share-fallback]");
		button.hidden = false;
		if (fallback) fallback.hidden = true;

		button.addEventListener("click", async () => {
			try {
				await navigator.share({
					title: container.dataset.shareTitle,
					url: container.dataset.shareUrl,
				});
			} catch {
				// el usuario canceló el share sheet
			}
		});
	});
</script>

<style>
	.compartir {
		margin-top: 2rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--color-separador);
		display: flex;
		align-items: center;
	}

	.compartir__nativo {
		display: flex;
		align-items: center;
		gap: 8px;
		font-family: var(--font-principal);
		font-size: 13px;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--color-magenta);
		background: none;
		border: 1.5px solid var(--color-magenta);
		border-radius: 999px;
		padding: 8px 18px;
		cursor: pointer;
		transition: color 0.15s ease, background-color 0.15s ease;
	}

	.compartir__nativo:hover {
		background: var(--color-magenta);
		color: #fff;
	}

	.compartir__lista {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.compartir__enlace {
		display: inline-flex;
		align-items: center;
		font-family: var(--font-principal);
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--color-gris-txt);
		border: 1.5px solid var(--color-separador);
		border-radius: 999px;
		padding: 6px 14px;
		transition: color 0.15s ease, border-color 0.15s ease;
	}

	.compartir__enlace:hover {
		color: var(--color-magenta);
		border-color: var(--color-magenta);
	}
</style>
