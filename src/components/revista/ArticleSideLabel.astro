---
import { Image } from "astro:assets";
import cosmocan from "@assets/revista/imagenes/cosmocan.png";

interface Props {
	label: string;
}

const { label } = Astro.props;
---

<aside class="article-side-label" aria-hidden="true">
	<div class="article-side-label__sticky">
		<div class="article-side-label__line" aria-hidden="true" />
		<span class="article-side-label__text">{label}</span>
		<Image
			src={cosmocan}
			alt=""
			class="article-side-label__mascota"
			width={34}
			height={34}
		/>
		<span class="article-side-label__circulo" aria-hidden="true" />
	</div>
</aside>
