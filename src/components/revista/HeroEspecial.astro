---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

import ArticleSummary from "@components/revista/ArticleSummary.astro";
import { MENU_SECTION_LABELS } from "@consts";

interface Props {
	article: CollectionEntry<"revista">;
}

const { article } = Astro.props;
const { title, summary, image, imageAlt } = article.data;
const href = `/revista/${article.data.slug ?? article.id}`;
const eyebrow = MENU_SECTION_LABELS[article.data.menuSection].toUpperCase();
---

<section class="hero-especial">
	<div class="hero-especial__imagen">
		<a href={href} class="hero-especial__imagen-link">
			{
				image ? (
					<div class="hero-especial__foto-wrap">
						<Image
							src={image}
							alt={imageAlt ?? title}
							class="hero-especial__foto"
							width={600}
							height={600}
						/>
					</div>
				) : (
					<div class="hero-especial__foto-wrap hero-especial__foto-wrap--placeholder" />
				)
			}
		</a>
	</div>
	<div class="hero-especial__contenido">
		<p class="hero-especial__eyebrow">{eyebrow}</p>
		<div class="hero-especial__bloque">
			<h1 class="hero-especial__titulo">
				<a href={href}>{title}</a>
			</h1>
		</div>
		<ArticleSummary summary={summary} class="hero-especial__bajada" />
		<a href={href} class="hero-especial__cta">
			<span class="icono-circulo" aria-hidden="true" />
			Leer especial completo
		</a>
	</div>
</section>

<style>
	.hero-especial {
		display: grid;
		grid-template-columns: 33fr 66fr;
		gap: 0;
		align-items: center;
		padding: 0;
	}

	.hero-especial__imagen {
		display: flex;
		justify-content: center;
	}

	.hero-especial__imagen-link {
		display: block;
	}

	.hero-especial__imagen-link:hover .hero-especial__foto {
		transform: scale(1.03);
		transition: transform 0.3s ease;
	}

	.hero-especial__foto-wrap {
		width: min(100%, 520px);
		aspect-ratio: 1;
		border-radius: 50%;
		overflow: hidden;
		flex-shrink: 0;
	}

	.hero-especial__foto {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.hero-especial__foto-wrap--placeholder {
		background: var(--color-gris-borde);
	}

	.hero-especial__contenido {
		padding-left: 2rem;
	}

	.hero-especial__eyebrow {
		font-size: var(--size-eyebrow);
		font-weight: 700;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--color-magenta);
		margin: 0 0 16px;
	}

	.hero-especial__bloque {
		display: inline-block;
		margin-bottom: 16px;
	}

	.hero-especial__titulo {
		display: inline;
		font-family: var(--font-serif);
		font-size: var(--size-h1-especial);
		font-weight: 900;
		line-height: 1.1;
	}

	.hero-especial__titulo a {
		color: var(--color-negro);
		transition: color 0.15s ease;
	}

	.hero-especial__titulo a:hover {
		color: var(--color-magenta);
	}

	.hero-especial__bajada {
		font-size: 16px;
		line-height: 1.6;
		color: var(--color-texto);
		margin: 0 0 20px;
		max-width: 480px;
	}

	.hero-especial__cta {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font-size: 13px;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-magenta);
		transition: opacity 0.15s ease;
	}

	.hero-especial__cta:hover {
		opacity: 0.75;
	}

	@media (max-width: 768px) {
		.hero-especial {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.hero-especial__contenido {
			padding-left: 0;
		}

		.hero-especial__foto-wrap {
			width: min(100%, 360px);
			margin: 0 auto;
		}

		.hero-especial__imagen {
			justify-content: center;
		}
	}
</style>
