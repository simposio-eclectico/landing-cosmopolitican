---
import type { CollectionEntry } from "astro:content";
import { formatDurationLabel } from "@lib/videoArticle";

interface Props {
	articles: CollectionEntry<"revista">[];
	heading?: string;
	archiveHref?: string;
	archiveLabel?: string;
}

const {
	articles,
	heading = "Más historias que te pueden interesar",
	archiveHref = "/revista/numeros",
	archiveLabel = "Ver archivo",
} = Astro.props;
---

{
	articles.length > 0 && (
		<aside class="relacionados-sidebar">
			<h2 class="relacionados-sidebar__titulo">{heading}</h2>

			<ul class="relacionados-sidebar__lista">
				{articles.map((article) => {
					const href = `/revista/${article.data.slug ?? article.id}`;
					const durationLabel =
						article.data.format === "video" && article.data.duration
							? formatDurationLabel(article.data.duration)
							: "";

					return (
						<li class="relacionados-sidebar__item">
							<a href={href} class="relacionados-sidebar__link">
								{
									article.data.image && (
										<img
											src={article.data.image}
											alt={article.data.imageAlt ?? article.data.title}
											class="relacionados-sidebar__image"
											loading="lazy"
											width="120"
											height="80"
										/>
									)
								}
								<div class="relacionados-sidebar__body">
									<h3 class="relacionados-sidebar__card-title">
										{article.data.title}
									</h3>
									{
										durationLabel && (
											<p class="relacionados-sidebar__duration">
												<svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
													<circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2" />
													<path d="M12 7v5l3 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
												</svg>
												{durationLabel}
											</p>
										)
									}
								</div>
							</a>
						</li>
					);
				})}
			</ul>

			<div class="relacionados-sidebar__footer">
				<a href={archiveHref} class="relacionados-sidebar__cta">
					<span class="icono-circulo" aria-hidden="true" />
					{archiveLabel}
				</a>
			</div>
		</aside>
	)
}

<style>
	.relacionados-sidebar {
		border-top: 1px solid var(--color-separador);
		padding-top: 1.5rem;
	}

	.relacionados-sidebar__titulo {
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--color-nav-activo);
		margin: 0 0 1.25rem;
		padding-bottom: 0.75rem;
		border-bottom: 1px solid var(--color-separador);
	}

	.relacionados-sidebar__lista {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.relacionados-sidebar__link {
		display: grid;
		grid-template-columns: 96px minmax(0, 1fr);
		gap: 12px;
		align-items: start;
	}

	.relacionados-sidebar__image {
		width: 96px;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		display: block;
	}

	.relacionados-sidebar__card-title {
		font-size: 15px;
		font-weight: 700;
		line-height: 1.3;
		color: var(--color-texto);
		margin: 0 0 6px;
		transition: color 0.15s ease;
	}

	.relacionados-sidebar__link:hover .relacionados-sidebar__card-title {
		color: var(--color-magenta);
	}

	.relacionados-sidebar__duration {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin: 0;
		font-size: 12px;
		color: var(--color-magenta);
	}

	.relacionados-sidebar__footer {
		margin-top: 1.5rem;
		padding-top: 1rem;
		border-top: 1px solid var(--color-separador);
	}

	.relacionados-sidebar__cta {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-magenta);
		transition: opacity 0.15s ease;
	}

	.relacionados-sidebar__cta:hover {
		opacity: 0.75;
	}
</style>
