---
const LABEL_TEXT = "Fechas de sentido";
---

<aside class="side-label" aria-hidden="true">
	<span class="side-label__text">{LABEL_TEXT}</span>
	<span class="icono-circulo side-label__icono" />
</aside>

<style>
	.side-label {
		position: fixed;
		left: 16px;
		top: 50%;
		transform: translateY(-50%);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 12px;
		z-index: 10;
		pointer-events: none;
	}

	.side-label__text {
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.25em;
		text-transform: uppercase;
		color: var(--color-gris-txt);
		writing-mode: vertical-rl;
		transform: rotate(180deg);
	}

	@media (max-width: 768px) {
		.side-label {
			display: none;
		}
	}
</style>
