---
import type { CollectionEntry } from "astro:content";
import ArticleSideLabel from "@components/revista/ArticleSideLabel.astro";
import RelatedArticlesSidebar from "@components/revista/RelatedArticlesSidebar.astro";
import VideoPlayer from "@components/revista/VideoPlayer.astro";
import { formatDurationLabel, getVideoSeekUrl } from "@lib/videoArticle";
import "@styles/articulo-video.css";

interface Props {
	post: CollectionEntry<"revista">;
	relatedArticles: CollectionEntry<"revista">[];
}

const { post, relatedArticles } = Astro.props;
const {
	title,
	author,
	summary,
	section,
	image,
	imageAlt,
	duration = "",
	videoUrl = "",
	transcriptionFragments = [],
} = post.data;

const formattedDate = post.data.pubDate.toLocaleDateString("es-ES", {
	year: "numeric",
	month: "long",
	day: "numeric",
});

const sideLabel = section.toUpperCase();
const durationLabel = duration ? formatDurationLabel(duration) : "";
---

<ArticleSideLabel label={sideLabel} />

<article class="video-articulo">
	<div class="video-articulo__contenedor contenedor">
		<header class="video-articulo__hero">
			<div class="video-articulo__hero-grid">
				<div class="video-articulo__media">
					<p class="video-articulo__tipo">
						<span class="icono-circulo" aria-hidden="true" />
						Entrevista audiovisual
					</p>
					<VideoPlayer
						videoUrl={videoUrl}
						poster={image}
						posterAlt={imageAlt ?? title}
						duration={durationLabel}
					/>
				</div>

				<div class="video-articulo__cabecera">
					<div class="video-articulo__rubro">
						<p class="video-articulo__eyebrow">{sideLabel}</p>
						<span class="video-articulo__rubro-icono" aria-hidden="true">
							<span class="icono-circulo" />
						</span>
						<time
							class="video-articulo__fecha"
							datetime={post.data.pubDate.toISOString()}
						>
							{formattedDate}
						</time>
					</div>

					<h1 class="video-articulo__titulo">{title}</h1>
					<p class="video-articulo__bajada">{summary}</p>

					<div class="video-articulo__meta">
						<span class="video-articulo__autor">
							entrevista por <em>{author}</em>
						</span>
						{
							durationLabel && (
								<>
									<span class="video-articulo__meta-separador" aria-hidden="true" />
									<span class="video-articulo__stat">
										<svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
											<circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2" />
											<path d="M12 7v5l3 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
										</svg>
										{durationLabel}
									</span>
								</>
							)
						}
					</div>

					<div class="video-articulo__intro">
						<slot />
					</div>
				</div>
			</div>
		</header>

		<div class="video-articulo__cuerpo">
			<section class="video-articulo__fragmentos" aria-labelledby="fragmentos-titulo">
				<h2 id="fragmentos-titulo" class="video-articulo__fragmentos-titulo">
					Fragmentos de la transcripción
				</h2>

				<div class="video-articulo__fragmentos-grid">
					{
						transcriptionFragments.map((fragment) => {
							const seekUrl = getVideoSeekUrl(videoUrl, fragment.time);

							return (
								<article class="video-articulo__fragmento">
									{
										seekUrl ? (
											<a href={seekUrl} class="video-articulo__fragmento-trigger">
												<span class="video-articulo__fragmento-play" aria-hidden="true">
													<svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
														<path d="M8 5v14l11-7z" />
													</svg>
												</span>
												<span class="video-articulo__fragmento-tiempo">
													{fragment.time}
												</span>
											</a>
										) : (
											<div class="video-articulo__fragmento-trigger">
												<span class="video-articulo__fragmento-play" aria-hidden="true">
													<svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
														<path d="M8 5v14l11-7z" />
													</svg>
												</span>
												<span class="video-articulo__fragmento-tiempo">
													{fragment.time}
												</span>
											</div>
										)
									}
									<p class="video-articulo__fragmento-texto">{fragment.text}</p>
								</article>
							);
						})
					}
				</div>
			</section>

			<RelatedArticlesSidebar
				articles={relatedArticles}
				heading="Más historias que te pueden interesar"
				archiveHref="/revista/numeros"
				archiveLabel="Más entrevistas audiovisuales"
			/>
		</div>
	</div>
</article>
