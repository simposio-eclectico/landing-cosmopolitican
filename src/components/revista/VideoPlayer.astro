---
interface Props {
	videoUrl?: string;
	poster?: string;
	posterAlt?: string;
	duration?: string;
}

const { videoUrl = "", poster, posterAlt = "", duration } = Astro.props;

const isYoutube =
	videoUrl.includes("youtube.com") || videoUrl.includes("youtu.be");

const youtubeEmbedUrl = (() => {
	if (!isYoutube) {
		return "";
	}

	try {
		const url = new URL(videoUrl);
		const videoId =
			url.searchParams.get("v") ??
			url.pathname.split("/").filter(Boolean).at(-1);

		return videoId ? `https://www.youtube.com/embed/${videoId}` : "";
	} catch {
		return "";
	}
})();
---

<div class="video-player" data-video-player>
	{
		isYoutube && youtubeEmbedUrl ? (
			<div class="video-player__embed" hidden data-video-embed>
				<iframe
					src={youtubeEmbedUrl}
					title={posterAlt}
					allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
					allowfullscreen
				/>
			</div>
		) : videoUrl ? (
			<video
				class="video-player__element"
				controls
				preload="metadata"
				poster={poster}
				hidden
				data-video-element
			>
				<source src={videoUrl} type="video/mp4" />
			</video>
		) : null
	}

	<button
		type="button"
		class="video-player__poster"
		data-video-trigger
		aria-label="Reproducir entrevista"
		disabled={!videoUrl}
	>
		{
			poster && (
				<img
					src={poster}
					alt={posterAlt}
					class="video-player__poster-image"
					width="960"
					height="540"
				/>
			)
		}
		<span class="video-player__overlay" aria-hidden="true" />
		<span class="video-player__play" aria-hidden="true">
			<svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
				<path d="M8 5v14l11-7z" />
			</svg>
		</span>
		{
			duration && (
				<span class="video-player__duration" aria-hidden="true">
					{duration}
				</span>
			)
		}
	</button>
</div>

<script>
	document.querySelectorAll("[data-video-player]").forEach((player) => {
		const trigger = player.querySelector("[data-video-trigger]");
		const video = player.querySelector("[data-video-element]");
		const embed = player.querySelector("[data-video-embed]");

		trigger?.addEventListener("click", () => {
			if (!(trigger instanceof HTMLButtonElement) || trigger.disabled) {
				return;
			}

			trigger.hidden = true;

			if (video instanceof HTMLVideoElement) {
				video.hidden = false;
				video.play();
				return;
			}

			if (embed instanceof HTMLElement) {
				embed.hidden = false;
			}
		});
	});
</script>

<style>
	.video-player {
		position: relative;
		width: 100%;
		background: var(--color-negro);
	}

	.video-player__poster {
		position: relative;
		display: block;
		width: 100%;
		padding: 0;
		border: none;
		background: none;
		cursor: pointer;
	}

	.video-player__poster:disabled {
		cursor: default;
	}

	.video-player__poster-image {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
	}

	.video-player__overlay {
		position: absolute;
		inset: 0;
		background: color-mix(in srgb, var(--color-negro) 25%, transparent);
	}

	.video-player__play {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		display: flex;
		align-items: center;
		justify-content: center;
		width: 72px;
		height: 72px;
		border-radius: 50%;
		background: color-mix(in srgb, var(--color-blanco) 88%, transparent);
		color: var(--color-magenta);
	}

	.video-player__duration {
		position: absolute;
		right: 12px;
		bottom: 12px;
		padding: 4px 8px;
		font-size: 12px;
		font-weight: 700;
		color: var(--color-blanco);
		background: color-mix(in srgb, var(--color-negro) 65%, transparent);
	}

	.video-player__element,
	.video-player__embed {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
	}

	.video-player__embed iframe {
		width: 100%;
		height: 100%;
		border: 0;
	}
</style>
