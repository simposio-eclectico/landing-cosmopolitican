---
import BaseHead from "@components/BaseHead.astro";
import {
  SITE_SLOGAN,
  SITE_TITLE,
  SITE_DESCRIPTION,
  SITE_NAME,
  CURRENT_ISSUE,
} from "@consts";
import { buildDrawerMenu, getLeadArticle } from "@lib/revistaMenu";
import "@styles/elegant.css";
import { getCollection } from "astro:content";

interface Props {
  title?: string;
  description?: string;
  background?: string;
}
const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  background,
} = Astro.props;

const revistas = await getCollection("revista");
const leadArticle = getLeadArticle(revistas);
const leadSlug = leadArticle ? leadArticle.data.slug || leadArticle.id : "";
const drawerMenuItems = buildDrawerMenu(revistas);
---

<!doctype html>
<html lang="es" class="theme-pop">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body>
    <!-- ── Topbar anuncio opcional ── -->
    <div class="topbar" id="topbar-announcement" style="cursor: pointer;">
      ★ ¡Nueva edición disponible! &nbsp;·&nbsp; Descúbrela ahora ★
    </div>

    <nav class="site-nav">
      <!-- Logo/marca con fuente script -->
      <a href="/" class="nav-brand">
        <img src="/logo.png" alt={SITE_NAME} class="brand-logo" />
      </a>

      <ul class="nav-links">
        <li>
          <a
            href="/revista/numeros"
            class={Astro.url.pathname.includes("/revista") ? "active" : ""}
          >
            Números
          </a>
        </li>
        <li>
          <button id="nav-latest-issue-btn" class="nav-btn-link">
            Último número
          </button>
        </li>
        <li>
          <a
            href="/quienes-somos"
            class={Astro.url.pathname.includes("/quienes-somos")
              ? "active"
              : ""}
          >
            Quiénes somos
          </a>
        </li>
        <li>
          <a
            href="/contacto"
            class={Astro.url.pathname.includes("/contacto") ? "active" : ""}
          >
            Contacto
          </a>
        </li>
      </ul>

      <!-- CTA derecho opcional -->
      <a href="/suscribirse" class="nav-cta">¡Suscríbete!</a>
    </nav>

    <main
      style={background
        ? `background-image: ${background}; background-position: center top;`
        : ""}
    >
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <img src="/logo.png" alt={SITE_NAME} class="brand-logo" />
          <span class="label-caps" style="color:#aaa; margin-top:0.25rem"
            >{SITE_SLOGAN}</span
          >
        </div>
        <nav class="footer-links">
          <a href="/revista/numeros">Números</a>
          <button id="footer-latest-issue-btn" class="footer-btn-link">
            Último número
          </button>
          <a href="/quienes-somos">Quiénes somos</a>
          <a href="/contacto">Contacto</a>
        </nav>
        <div class="footer-copy">
          <span class="label-caps" style="color:#666"
            >© {new Date().getFullYear()} {SITE_NAME}</span
          >
        </div>
      </div>
    </footer>

    <!-- Revista Menu Drawer -->
    <div id="revista-drawer" class="drawer-overlay">
      <div class="drawer-container">
        <div class="drawer-left-bar"></div>
        <div class="drawer-content">
          <button id="close-drawer" class="close-btn" aria-label="Cerrar"
            >&times;</button
          >
          <div class="drawer-header">
            <span class="drawer-issue-number" id="drawer-issue-number">
              {CURRENT_ISSUE.number}
            </span>
            <h2 class="drawer-issue-title" id="drawer-issue-title">
              {CURRENT_ISSUE.title}
            </h2>
          </div>
          <nav class="drawer-menu">
            {
              drawerMenuItems.map((item) => {
                if (item.type === "heading") {
                  return (
                    <div class="menu-section">
                      <span class="menu-category">{item.label}</span>
                    </div>
                  );
                }

                if (item.type === "article") {
                  return (
                    <div class="menu-section">
                      <a
                        href={item.href}
                        class={`menu-link ${item.style === "main" ? "main-link" : "sub-link"}`.trim()}
                      >
                        {item.label}
                      </a>
                    </div>
                  );
                }

                return (
                  <div class="menu-section">
                    <button
                      type="button"
                      class={`menu-link placeholder-link ${item.style === "sub" ? "placeholder-sub-link" : ""}`.trim()}
                    >
                      {item.label}
                    </button>
                  </div>
                );
              })
            }
          </nav>
        </div>
      </div>
    </div>

    <!-- Brutalist Toast Notification -->
    <div id="brutalist-toast" class="brutalist-toast">
      Sección tentativa - Próximamente en la edición impresa.
    </div>

    <script define:vars={{ leadSlug, issueNumber: CURRENT_ISSUE.number, issueTitle: CURRENT_ISSUE.title }}>
      document.addEventListener("DOMContentLoaded", () => {
        const drawer = document.getElementById("revista-drawer");
        const closeBtn = document.getElementById("close-drawer");
        const toast = document.getElementById("brutalist-toast");

        function openDrawer() {
          if (!leadSlug) return;

          drawer.classList.add("active");
          document.body.style.overflow = "hidden";
        }

        function closeDrawer() {
          drawer.classList.remove("active");
          document.body.style.overflow = "";
        }

        window.openRevistaDrawer = openDrawer;

        closeBtn.addEventListener("click", closeDrawer);
        drawer.addEventListener("click", (e) => {
          if (e.target === drawer) {
            closeDrawer();
          }
        });

        const topbar = document.getElementById("topbar-announcement");
        if (topbar) {
          topbar.addEventListener("click", openDrawer);
        }

        const navBtn = document.getElementById("nav-latest-issue-btn");
        if (navBtn) {
          navBtn.addEventListener("click", openDrawer);
        }

        const footerBtn = document.getElementById("footer-latest-issue-btn");
        if (footerBtn) {
          footerBtn.addEventListener("click", openDrawer);
        }

        const placeholders = drawer.querySelectorAll(
          ".placeholder-link, .placeholder-sub-link",
        );
        placeholders.forEach((btn) => {
          btn.addEventListener("click", () => {
            toast.classList.add("show");
            setTimeout(() => {
              toast.classList.remove("show");
            }, 3000);
          });
        });
      });
    </script>
  </body>
</html>

<style>
  /* ── Topbar ── */
  .topbar {
    background: var(--c-hot);
    color: #fff;
    text-align: center;
    font-family: var(--c-font-display);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    padding: 0.4rem 1rem;
    border-bottom: 2px solid var(--c-black);
  }

  /* ── Nav ── */
  .site-nav {
    display: flex;
    align-items: stretch;
    border-bottom: var(--c-border-thick);
    background: var(--c-bg);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .nav-brand {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0.6rem 1.5rem;
    background: var(--c-black);
    border-right: var(--c-border-thick);
    flex-shrink: 0;
    gap: 0.1rem;
    transition: background 0.2s;
  }
  .nav-brand:hover {
    background: var(--c-hot);
  }

  .brand-logo {
    height: auto;
    max-height: 1.8rem;
    width: auto;
    display: block;
  }

  .brand-script {
    font-family: var(--c-font-brand);
    font-size: 1.4rem;
    color: #fff;
    line-height: 1;
  }
  .brand-sub {
    font-family: var(--c-font-display);
    font-size: 0.6rem;
    letter-spacing: 0.35em;
    color: var(--c-yellow);
    line-height: 1;
    margin-left: 3px;
    text-transform: uppercase;
  }

  .nav-links {
    display: flex;
    flex: 1;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-links li {
    display: flex;
  }

  .nav-links a {
    padding: 0 1.25rem;
    font-family: var(--c-font-display);
    font-size: 0.8rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--c-black);
    display: flex;
    align-items: center;
    border-right: 2px solid var(--c-black);
    border-bottom: 4px solid transparent;
    transition:
      color 0.15s,
      border-bottom-color 0.15s,
      background 0.15s;
  }

  .nav-links a:hover {
    background: var(--c-yellow);
    border-bottom-color: var(--c-black);
  }
  .nav-links a.active {
    color: var(--c-hot);
    border-bottom-color: var(--c-hot);
    background: #fff0f6;
  }

  .nav-cta {
    margin: auto 1rem auto auto;
    font-family: var(--c-font-display);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: var(--c-hot);
    color: #fff;
    padding: 0.5em 1.2em;
    border: var(--c-border-thick);
    box-shadow: var(--c-shadow-pop);
    transition:
      transform 0.15s,
      box-shadow 0.15s;
    white-space: nowrap;
  }
  body {
    margin: 0;
    overflow-x: hidden;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
  .nav-cta:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0px var(--c-black);
  }

  /* ── Main ── */
  main {
    flex: 1;
    padding: 3rem 2rem;
    margin: 0;
    width: 100%;
    box-sizing: border-box;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  /* ── Footer ── */
  .site-footer {
    border-top: var(--c-border-thick);
    background: var(--c-black);
    color: var(--c-bg);
    padding: 3rem 2rem;
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
  }

  .footer-links {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .footer-links a {
    font-family: var(--c-font-display);
    font-size: 0.8rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #aaa;
    transition: color 0.2s;
  }
  .footer-links a:hover {
    color: var(--c-hot);
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .nav-links {
      display: none; /* colapsar en mobile con hamburger si aplica */
    }
    .nav-brand {
      width: 100%;
      align-items: center;
      border-right: none;
      border-bottom: var(--c-border-thick);
    }
  }
  /* ── Latest Issue Nav/Footer Buttons ── */
  .nav-btn-link {
    background: none;
    border: none;
    padding: 0 1.25rem;
    font-family: var(--c-font-display);
    font-size: 0.8rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--c-black);
    display: flex;
    align-items: center;
    border-right: 2px solid var(--c-black);
    border-bottom: 4px solid transparent;
    transition:
      color 0.15s,
      border-bottom-color 0.15s,
      background 0.15s;
    cursor: pointer;
    height: 100%;
  }

  .nav-btn-link:hover {
    background: var(--c-yellow);
    border-bottom-color: var(--c-black);
  }

  .footer-btn-link {
    background: none;
    border: none;
    padding: 0;
    font-family: var(--c-font-display);
    font-size: 0.8rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #aaa;
    transition: color 0.2s;
    cursor: pointer;
  }
  .footer-btn-link:hover {
    color: var(--c-hot);
  }

  /* ── Drawer Overlay ── */
  .drawer-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(4px);
    z-index: 1000;
    display: flex;
    justify-content: flex-start;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .drawer-overlay.active {
    opacity: 1;
    pointer-events: auto;
  }

  /* Drawer Container */
  .drawer-container {
    width: 100%;
    max-width: 480px;
    height: 100%;
    background-color: var(--c-bg);
    border-right: var(--c-border-thick);
    box-shadow: 10px 0 0 var(--c-black);
    display: flex;
    transform: translateX(-100%);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .drawer-overlay.active .drawer-container {
    transform: translateX(0);
  }

  /* Left black bar */
  .drawer-left-bar {
    width: 32px;
    background-color: var(--c-black);
    flex-shrink: 0;
  }

  /* Drawer Content */
  .drawer-content {
    flex: 1;
    padding: 3rem 2.5rem;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow-y: auto;
  }

  /* Close button */
  .close-btn {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    background: none;
    border: none;
    font-size: 2.5rem;
    font-weight: 300;
    cursor: pointer;
    color: var(--c-black);
    transition: color 0.2s;
  }

  .close-btn:hover {
    color: var(--c-hot);
  }

  /* Header */
  .drawer-header {
    margin-top: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .drawer-issue-number {
    font-family: var(--c-font-display);
    font-size: 2rem;
    color: transparent;
    -webkit-text-stroke: 1px var(--c-black);
    letter-spacing: -0.05em;
    display: block;
  }

  .drawer-issue-title {
    font-family: var(--c-font-display);
    font-size: 3rem;
    line-height: 1.1;
    margin: 0.25rem 0 0;
    color: var(--c-black);
    text-transform: uppercase;
  }

  /* Menu navigation */
  .drawer-menu {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    align-items: flex-start;
  }

  .menu-section {
    width: 100%;
  }

  .menu-link {
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    font-family: var(--c-font-display), sans-serif;
    text-align: left;
    text-transform: uppercase;
    cursor: pointer;
    color: var(--c-black);
    display: block;
    transition:
      color 0.15s,
      transform 0.15s;
    width: 100%;
  }

  .menu-link.main-link {
    color: var(--c-black);
    font-size: 2.2rem;
    font-weight: bold;
  }

  .menu-link.main-link:hover {
    color: var(--c-hot);
    transform: translateX(5px);
  }

  .menu-link.sub-link {
    font-size: 1.4rem;
    font-weight: normal;
    padding-left: 1.5rem;
    text-decoration: none;
  }

  .menu-link.sub-link:hover {
    color: var(--c-hot);
    transform: translateX(5px);
  }

  .menu-link.placeholder-link {
    font-size: 2.2rem;
    font-weight: bold;
  }

  .menu-link.placeholder-sub-link {
    font-size: 1.4rem;
    font-weight: normal;
    padding-left: 1.5rem;
    color: var(--c-muted);
  }

  .menu-link.placeholder-link:hover,
  .menu-link.placeholder-sub-link:hover {
    color: var(--c-hot);
    transform: translateX(5px);
  }

  .menu-category {
    font-family: var(--c-font-display), sans-serif;
    font-size: 2.2rem;
    font-weight: bold;
    color: var(--c-black);
    display: block;
    margin-top: 1rem;
    margin-bottom: 0.2rem;
    text-transform: uppercase;
  }

  /* Brutalist Toast */
  .brutalist-toast {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    background-color: var(--c-yellow);
    color: var(--c-black);
    border: var(--c-border-thick);
    box-shadow: var(--c-shadow-pop);
    padding: 1rem 1.5rem;
    font-family: var(--c-font-body);
    font-weight: bold;
    z-index: 1100;
    transform: translateY(150%);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .brutalist-toast.show {
    transform: translateY(0);
  }
</style>
