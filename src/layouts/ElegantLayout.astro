---
import Analytics from "@components/Analytics.astro";
import BaseHead from "@components/BaseHead.astro";
import SearchModal from "@components/SearchModal.astro";
import type { ImageMetadata } from "astro";
import {
	SITE_SLOGAN,
	SITE_TITLE,
	SITE_DESCRIPTION,
	SITE_NAME,
	CURRENT_ISSUE,
	TOP_NAV_MENU_SECTIONS,
} from "@consts";
import { buildSearchIndex } from "@lib/searchIndex";
import { buildDrawerMenu, getLeadArticle } from "@lib/revistaMenu";
import "@styles/elegant.css";
import { getCollection } from "astro:content";

interface Props {
	title?: string;
	description?: string;
	image?: string | ImageMetadata;
	imageAlt?: string;
	socialTitle?: string;
	bare?: boolean;
}

const {
	title = SITE_TITLE,
	description = SITE_DESCRIPTION,
	image,
	imageAlt,
	socialTitle,
	bare = false,
} = Astro.props;

const revistas = await getCollection("revista");
const leadArticle = getLeadArticle(revistas);
const leadSlug = leadArticle ? leadArticle.data.slug || leadArticle.id : "";
const drawerMenuItems = buildDrawerMenu(revistas);
const searchIndex = await buildSearchIndex(revistas);

const navLinks = [
	{ label: "Inicio", href: "/", match: (path: string) => path === "/" },
	...TOP_NAV_MENU_SECTIONS.map(({ label, href }) => ({
		label,
		href,
		match: (path: string) => path === href || path.startsWith(`${href}/`),
	})),
	{
		label: "Somos",
		href: "/quienes-somos",
		match: (path: string) => path.includes("/quienes-somos"),
	},
	{
		label: "Contacto",
		href: "/contacto",
		match: (path: string) => path.includes("/contacto"),
	},
];

const currentPath = Astro.url.pathname;

const isNavActive = (href: string, match?: (path: string) => boolean) => {
	if (match) {
		return match(currentPath);
	}

	return currentPath === href || currentPath.startsWith(`${href}/`);
};
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={image}
			imageAlt={imageAlt}
			socialTitle={socialTitle}
		/>
	</head>
	<body>
		<Analytics part="body" />
		<header class="site-header">
			<nav class="site-nav contenedor" aria-label="Principal">
				<a href="/" class="nav-brand">
					<img
						src="/logo.png"
						alt={SITE_NAME}
						class="nav-brand__logo"
						width="519"
						height="617"
					/>
					<span class="nav-brand__tagline">{SITE_SLOGAN}</span>
				</a>

				<ul class="nav-links">
					{
						navLinks.map((link) => (
							<li>
								<a
									href={link.href}
									class:list={[
										"nav-link",
										{ "nav-link--active": isNavActive(link.href, link.match) },
									]}
								>
									{link.label}
								</a>
							</li>
						))
					}
				</ul>

				<div class="nav-utils">
					<span class="nav-separador" aria-hidden="true" />
					<SearchModal searchIndex={searchIndex} />
					<div class="nav-social">
					<a
						href="https://www.facebook.com/profile.php?id=61592491095086"
						class="nav-icon-btn"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Facebook"
					>
						<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z" />
						</svg>
					</a>
					<a
						href="https://www.instagram.com/cosmopolitican.revista"
						class="nav-icon-btn"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Instagram"
					>
						<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z" />
						</svg>
					</a>
					<a
						href="https://www.youtube.com/@cosmopolitican.revista"
						class="nav-icon-btn"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="YouTube"
					>
						<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
						</svg>
					</a>
					<a
						href="https://x.com/cosmopolitican"
						class="nav-icon-btn"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="X"
					>
						<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
						</svg>
					</a>
					<a
						href="https://t.me/Cosmopoliticanrevista"
						class="nav-icon-btn"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Telegram"
					>
						<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z" />
						</svg>
					</a>
					</div>
				</div>

				<button
					type="button"
					class="nav-hamburger"
					id="nav-hamburger"
					aria-label="Abrir menú"
					aria-expanded="false"
				>
					<span />
					<span />
					<span />
				</button>
			</nav>
		</header>

		<main class:list={["site-main", { "site-main--bare": bare }]}>
			<div class:list={["site-main__inner", { contenedor: bare }]}>
				<slot />
			</div>
		</main>

		<footer class="site-footer">
			<div class="site-footer__inner contenedor">
				<a href="/" class="site-footer__brand">
						<img
							src="/logo.png"
							alt={SITE_NAME}
							class="nav-brand__logo nav-brand__logo--small"
							width="519"
							height="617"
						/>
						<span class="site-footer__tagline">{SITE_SLOGAN}</span>
					</a>
				<a href="/" class="site-footer__copy">
					© {new Date().getFullYear()} {SITE_NAME}
				</a>
			</div>
		</footer>

		<div id="revista-drawer" class="drawer-overlay" role="dialog" aria-modal="true" aria-label="Menú del número">
			<div class="drawer-container">
				<div class="drawer-content">
					<button id="close-drawer" class="close-btn" aria-label="Cerrar">
						&times;
					</button>
					<div class="drawer-header">
						<span class="drawer-issue-number">{CURRENT_ISSUE.number}</span>
						<h2 class="drawer-issue-title">{CURRENT_ISSUE.title}</h2>
					</div>
					<nav class="drawer-menu">
						{
							drawerMenuItems.map((item) => {
								if (item.type !== "article") {
									return null;
								}

								return (
									<a
										href={item.href}
										class:list={[
											"drawer-menu-link",
											{ "drawer-menu-link--main": item.style === "main" },
										]}
									>
										{item.label}
									</a>
								);
							})
						}
					</nav>
				</div>
			</div>
		</div>

		<script define:vars={{ leadSlug }}>
			document.addEventListener("DOMContentLoaded", () => {
				const drawer = document.getElementById("revista-drawer");
				const closeBtn = document.getElementById("close-drawer");
				const hamburger = document.getElementById("nav-hamburger");
				const navLinks = document.querySelector(".nav-links");

				function openDrawer() {
					if (!leadSlug || !drawer) {
						return;
					}

					drawer.classList.add("active");
					document.body.style.overflow = "hidden";
				}

				function closeDrawer() {
					if (!drawer) {
						return;
					}

					drawer.classList.remove("active");
					document.body.style.overflow = "";
				}

				window.openRevistaDrawer = openDrawer;

				closeBtn?.addEventListener("click", closeDrawer);
				drawer?.addEventListener("click", (event) => {
					if (event.target === drawer) {
						closeDrawer();
					}
				});

				document
					.getElementById("footer-latest-issue-btn")
					?.addEventListener("click", openDrawer);

				hamburger?.addEventListener("click", () => {
					const isOpen = navLinks?.classList.toggle("nav-links--open");
					hamburger.setAttribute(
						"aria-expanded",
						isOpen ? "true" : "false",
					);
				});
			});
		</script>
	</body>
</html>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: var(--color-blanco);
		border-bottom: 1px solid var(--color-gris-borde);
	}

	.site-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 72px;
		gap: 1.5rem;
	}

	.nav-brand {
		display: flex;
		align-items: center;
		gap: 12px;
		flex-shrink: 0;
	}

	.nav-brand__logo {
		display: block;
		height: var(--size-logo);
		width: auto;
		flex-shrink: 0;
	}

	.nav-brand__logo--small {
		height: 32px;
	}

	.nav-brand__tagline {
		font-size: 12px;
		color: var(--color-gris-txt);
		white-space: nowrap;
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 0;
		margin: 0;
		padding: 0;
		list-style: none;
		flex: 1;
		justify-content: center;
	}

	.nav-links li {
		display: flex;
	}

	.nav-link {
		padding: 0 12px;
		font-size: var(--size-nav-link);
		color: var(--color-nav-link);
		line-height: 72px;
		white-space: nowrap;
		transition: color 0.15s ease;
	}

	.nav-link:hover {
		color: var(--color-magenta);
	}

	.nav-link--active {
		color: var(--color-nav-activo);
		text-decoration: underline;
		text-underline-offset: 4px;
		font-weight: bold;

	}

	.nav-utils {
		display: flex;
		align-items: center;
		gap: 12px;
		flex-shrink: 0;
	}

	.nav-social {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.nav-separador {
		width: 1px;
		height: 24px;
		background: var(--color-gris-borde);
	}

	.nav-icon-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		padding: 0;
		border: none;
		background: none;
		color: var(--color-nav-link);
		cursor: pointer;
		transition: color 0.15s ease;
	}

	.nav-icon-btn:hover {
		color: var(--color-magenta);
	}

	.nav-hamburger {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
		width: 32px;
		height: 32px;
		padding: 0;
		border: none;
		background: none;
		cursor: pointer;
	}

	.nav-hamburger span {
		display: block;
		width: 22px;
		height: 2px;
		background: var(--color-negro);
	}

	.site-main {
		flex: 1;
		padding: 3rem 0;
	}

	.site-main--bare {
		padding: 0;
	}

	body {
		margin: 0;
		display: flex;
		flex-direction: column;
		min-height: 100vh;
		overflow-x: hidden;
	}

	.site-footer {
		background: var(--color-negro);
		color: var(--color-blanco);
		padding: 2.5rem 0;
		margin-top: auto;
	}

	.site-footer__inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
	}

	.site-footer__brand {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.site-footer__tagline {
		font-size: 12px;
		color: #aaaaaa;
	}

	.drawer-overlay {
		position: fixed;
		inset: 0;
		background: rgba(0, 0, 0, 0.4);
		z-index: 1000;
		display: flex;
		justify-content: flex-start;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.3s ease;
	}

	.drawer-overlay.active {
		opacity: 1;
		pointer-events: auto;
	}

	.drawer-container {
		width: 100%;
		max-width: 420px;
		height: 100%;
		background: var(--color-blanco);
		border-right: 1px solid var(--color-gris-borde);
		transform: translateX(-100%);
		transition: transform 0.3s ease;
	}

	.drawer-overlay.active .drawer-container {
		transform: translateX(0);
	}

	.drawer-content {
		padding: 3rem 2rem;
		position: relative;
		overflow-y: auto;
		height: 100%;
	}

	.close-btn {
		position: absolute;
		top: 1rem;
		right: 1rem;
		background: none;
		border: none;
		font-size: 2rem;
		cursor: pointer;
		color: var(--color-negro);
		line-height: 1;
	}

	.drawer-issue-number {
		font-size: 14px;
		font-weight: 700;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: var(--color-magenta);
	}

	.drawer-issue-title {
		font-size: 28px;
		font-weight: 700;
		margin: 8px 0 0;
		color: var(--color-negro);
	}

	.drawer-menu {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin-top: 2rem;
	}

	.drawer-menu-link {
		font-size: 16px;
		color: var(--color-texto);
		transition: color 0.15s ease;
	}

	.drawer-menu-link--main {
		font-size: 20px;
		font-weight: 700;
		color: var(--color-magenta);
	}

	.drawer-menu-link:hover {
		color: var(--color-magenta);
	}

	@media (max-width: 1024px) {
		.nav-brand__tagline {
			display: none;
		}

		.nav-link {
			padding: 0 8px;
			font-size: 13px;
		}
	}

	@media (max-width: 768px) {
		.nav-links {
			display: none;
			position: absolute;
			top: 72px;
			left: 0;
			right: 0;
			flex-direction: column;
			background: var(--color-blanco);
			border-bottom: 1px solid var(--color-gris-borde);
			padding: 1rem 0;
		}

		.nav-links--open {
			display: flex;
		}

		.nav-links li {
			width: 100%;
		}

		.nav-link {
			line-height: 2.5;
			padding: 0 var(--padding-lateral);
			width: 100%;
		}

		.nav-utils {
			display: flex;
		}

		.nav-social {
			display: none;
		}

		.nav-separador {
			display: none;
		}

		.nav-hamburger {
			display: flex;
		}

		.site-nav {
			position: relative;
		}
	}
</style>
