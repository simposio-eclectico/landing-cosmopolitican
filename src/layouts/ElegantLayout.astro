---
import BaseHead from "@components/BaseHead.astro";
import { SITE_SLOGAN, SITE_TITLE, SITE_DESCRIPTION, SITE_NAME } from "@consts";
import "@styles/elegant.css";

interface Props {
  title?: string;
  description?: string;
  background?: string;
}
const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  background,
} = Astro.props;
---

<!doctype html>
<html lang="es" class="theme-pop">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body>
    <!-- ── Topbar anuncio opcional ── -->
    <div class="topbar">
      ★ ¡Nueva edición disponible! &nbsp;·&nbsp; Descúbrela ahora ★
    </div>

    <nav class="site-nav">
      <!-- Logo/marca con fuente script -->
      <a href="/" class="nav-brand">
        <img src="/logo.png" alt={SITE_NAME} class="brand-logo" />
        <span class="brand-sub">{SITE_SLOGAN}</span>
      </a>

      <ul class="nav-links">
        <li>
          <a
            href="/revista"
            class={Astro.url.pathname.includes("/revista") ? "active" : ""}
          >
            Revista
          </a>
        </li>
        <li>
          <a
            href="/quienes-somos"
            class={Astro.url.pathname.includes("/quienes-somos")
              ? "active"
              : ""}
          >
            Quiénes somos
          </a>
        </li>
        <li>
          <a
            href="/contacto"
            class={Astro.url.pathname.includes("/contacto") ? "active" : ""}
          >
            Contacto
          </a>
        </li>
      </ul>

      <!-- CTA derecho opcional -->
      <a href="/suscribirse" class="nav-cta">¡Suscríbete!</a>
    </nav>

<main style={background ? `background-image: ${background}; background-position: center top;` : ""}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <img src="/logo.png" alt={SITE_NAME} class="brand-logo" />
          <span class="label-caps" style="color:#aaa; margin-top:0.25rem"
            >{SITE_SLOGAN}</span>
        </div>
        <nav class="footer-links">
          <a href="/revista">Revista</a>
          <a href="/quienes-somos">Quiénes somos</a>
          <a href="/contacto">Contacto</a>
        </nav>
        <div class="footer-copy">
          <span class="label-caps" style="color:#666"
            >© {new Date().getFullYear()} {SITE_NAME}</span
          >
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  /* ── Topbar ── */
  .topbar {
    background: var(--c-hot);
    color: #fff;
    text-align: center;
    font-family: var(--c-font-display);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    padding: 0.4rem 1rem;
    border-bottom: 2px solid var(--c-black);
  }

  /* ── Nav ── */
  .site-nav {
    display: flex;
    align-items: stretch;
    border-bottom: var(--c-border-thick);
    background: var(--c-bg);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .nav-brand {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0.6rem 1.5rem;
    background: var(--c-black);
    border-right: var(--c-border-thick);
    flex-shrink: 0;
    gap: 0.1rem;
    transition: background 0.2s;
  }
  .nav-brand:hover {
    background: var(--c-hot);
  }

  .brand-logo {
    height: auto;
    max-height: 1.8rem;
    width: auto;
    display: block;
  }

  .brand-script {
    font-family: var(--c-font-brand);
    font-size: 1.4rem;
    color: #fff;
    line-height: 1;
  }
  .brand-sub {
    font-family: var(--c-font-display);
    font-size: 0.6rem;
    letter-spacing: 0.35em;
    color: var(--c-yellow);
    line-height: 1;
    margin-left: 3px;
    text-transform: uppercase;
  }

  .nav-links {
    display: flex;
    flex: 1;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-links li {
    display: flex;
  }

  .nav-links a {
    padding: 0 1.25rem;
    font-family: var(--c-font-display);
    font-size: 0.8rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--c-black);
    display: flex;
    align-items: center;
    border-right: 2px solid var(--c-black);
    border-bottom: 4px solid transparent;
    transition:
      color 0.15s,
      border-bottom-color 0.15s,
      background 0.15s;
  }

  .nav-links a:hover {
    background: var(--c-yellow);
    border-bottom-color: var(--c-black);
  }
  .nav-links a.active {
    color: var(--c-hot);
    border-bottom-color: var(--c-hot);
    background: #fff0f6;
  }

  .nav-cta {
    margin: auto 1rem auto auto;
    font-family: var(--c-font-display);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: var(--c-hot);
    color: #fff;
    padding: 0.5em 1.2em;
    border: var(--c-border-thick);
    box-shadow: var(--c-shadow-pop);
    transition:
      transform 0.15s,
      box-shadow 0.15s;
    white-space: nowrap;
  }
  body {
    margin: 0;
    overflow-x: hidden;
  }
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0px var(--c-black);
  }

  /* ── Main ── */
  main {
    flex: 1;
    padding: 3rem 2rem;
    margin: 0;
    width: 100%;
    height: 100vh;
    box-sizing: border-box;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }



  /* ── Footer ── */
  .site-footer {
    border-top: var(--c-border-thick);
    background: var(--c-black);
    color: var(--c-bg);
    padding: 3rem 2rem;
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
  }

  .footer-links {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .footer-links a {
    font-family: var(--c-font-display);
    font-size: 0.8rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #aaa;
    transition: color 0.2s;
  }
  .footer-links a:hover {
    color: var(--c-hot);
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .nav-links {
      display: none; /* colapsar en mobile con hamburger si aplica */
    }
    .nav-brand {
      width: 100%;
      align-items: center;
      border-right: none;
      border-bottom: var(--c-border-thick);
    }
  }
</style>
