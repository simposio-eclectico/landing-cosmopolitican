---
import { getCollection } from "astro:content";
import ArticleCard from "@components/revista/ArticleCard.astro";
import HeroEspecial from "@components/revista/HeroEspecial.astro";
import SideLabel from "@components/revista/SideLabel.astro";
import ElegantLayout from "@layouts/ElegantLayout.astro";
import { SITE_NAME } from "@consts";
import {
	getCoverCardArticles,
	getLeadArticle,
} from "@lib/revistaMenu";

const revistas = await getCollection("revista");
const leadArticle = getLeadArticle(revistas);
const cardArticles = getCoverCardArticles(revistas, leadArticle);
---

<ElegantLayout title={`${SITE_NAME} — Portada`} bare>
	<SideLabel />

	<div class="portada">
		{
			leadArticle && (
				<section class="portada__hero">
					<HeroEspecial article={leadArticle} />
				</section>
			)
		}

		{
			cardArticles.length > 0 && (
				<section class="portada__grid" aria-label="Artículos">
					{cardArticles.map((article) => (
						<ArticleCard article={article} />
					))}
				</section>
			)
		}
	</div>
</ElegantLayout>

<style>
	.portada {
		background: var(--color-blanco);
		padding-bottom: 48px;
	}

	.portada__hero {
		padding: 0 0 48px;
		border-bottom: 1px solid var(--color-separador);
	}

	.portada__grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--gap-cards);
		padding-top: 48px;
	}

	@media (max-width: 1024px) {
		.portada__grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 768px) {
		.portada__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
