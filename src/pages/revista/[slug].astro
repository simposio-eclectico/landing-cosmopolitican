---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import ArticleOriginalLink from "@components/revista/ArticleOriginalLink.astro";
import ArticleSideLabel from "@components/revista/ArticleSideLabel.astro";
import ArticleHeroCaption from "@components/revista/ArticleHeroCaption.astro";
import ArticleHeroImage from "@components/revista/ArticleHeroImage.astro";
import VideoArticle from "@components/revista/VideoArticle.astro";
import RelatedArticles from "@components/revista/RelatedArticles.astro";
import ElegantLayout from "@layouts/ElegantLayout.astro";
import { SITE_NAME, MENU_SECTION_LABELS } from "@consts";
import { formatWordCount, getReadingMeta } from "@lib/articuloMeta";
import { revistaMdxComponents } from "@lib/revistaMdxComponents";
import { getRelatedArticles } from "@lib/revistaMenu";
import "@styles/articulo.css";

export async function getStaticPaths() {
	const revistas = await getCollection("revista");
	return revistas.map((post) => ({
		params: { slug: post.data.slug || post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);
const revistas = await getCollection("revista");
const relatedArticles = getRelatedArticles(revistas, post.id, post.data.issueNumber);
const { minutes, words } = getReadingMeta(post.body ?? "");

const formattedDate = post.data.pubDate.toLocaleDateString("es-ES", {
	year: "numeric",
	month: "long",
	day: "numeric",
});

const sideLabel = MENU_SECTION_LABELS[post.data.menuSection].toUpperCase();
const marginLabel = `${MENU_SECTION_LABELS[post.data.menuSection]}`;
const relatedHeading = `Te puede interesar`;
const isVideoArticle = post.data.format === "video";
const isFeaturedHero = post.data.theme === "featured" && Boolean(post.data.image);
const heroImageAlt = post.data.imageAlt ?? "";
const heroCaptionProps = {
	caption: post.data.imageCaption,
	credit: post.data.imageCredit,
	creditUrl: post.data.imageCreditUrl,
	license: post.data.imageLicense,
	licenseUrl: post.data.imageLicenseUrl,
};
const showHeroCaption = Boolean(
	heroCaptionProps.caption ||
		heroCaptionProps.credit ||
		heroCaptionProps.license,
);
---

<ElegantLayout
	title={`${post.data.title} - ${SITE_NAME}`}
	description={post.data.summary}
	image={post.data.image}
	imageAlt={post.data.imageAlt}
	bare
>
	{
		isVideoArticle ? (
			<VideoArticle post={post} relatedArticles={relatedArticles}>
				<Content components={revistaMdxComponents} />
			</VideoArticle>
		) : (
			<>
				<article class:list={["articulo", { "articulo--portada": isFeaturedHero }]}>
					<div class="articulo__layout">
						<ArticleSideLabel label={marginLabel} />

						<div class="articulo__columna">
							{
								isFeaturedHero && (
									<header class="articulo__hero articulo__hero--portada">
										<Image
											class="articulo__hero-portada-imagen"
											src={post.data.image!}
											alt={heroImageAlt}
											width={1440}
											height={640}
										/>
										<div class="articulo__hero-portada-overlay" aria-hidden="true" />
										<div class="articulo__hero-portada-contenido">
											<div class="articulo__rubro articulo__rubro--portada">
												<p class="articulo__eyebrow articulo__eyebrow--portada">{sideLabel}</p>
												<span class="articulo__rubro-punto" aria-hidden="true">•</span>
												<time
													class="articulo__fecha articulo__fecha--portada"
													datetime={post.data.pubDate.toISOString()}
												>
													{formattedDate}
												</time>
											</div>

											<h1 class="articulo__titulo articulo__titulo--portada">{post.data.title}</h1>
											{
												post.data.subtitle && (
													<p class="articulo__subtitulo">{post.data.subtitle}</p>
												)
											}
											<p class="articulo__bajada articulo__bajada--portada">{post.data.summary}</p>

											<div class="articulo__meta articulo__meta--portada">
												<span class="articulo__autor articulo__autor--portada">
													por <em>{post.data.author}</em>
												</span>
												<span class="articulo__stat articulo__stat--portada" aria-label="Tiempo de lectura">
													<svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
														<circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2" />
														<path d="M12 7v5l3 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
													</svg>
													{minutes} min de lectura
												</span>
												<span class="articulo__stat articulo__stat--portada" aria-label="Cantidad de palabras">
													<svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
														<path d="M5 5h14v14H5z" stroke="currentColor" stroke-width="2" />
														<path d="M9 9h6M9 13h6M9 17h4" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
													</svg>
													{formatWordCount(words)} palabras aprox.
												</span>
											</div>
										</div>
									</header>
								)
							}

							<div class="articulo__contenedor">
						{
							showHeroCaption && isFeaturedHero && (
								<ArticleHeroCaption {...heroCaptionProps} />
							)
						}

						{
							!isFeaturedHero && (
								<header class="articulo__hero">
									<div
										class:list={[
											"articulo__hero-grid",
											{ "articulo__hero-grid--sin-imagen": !post.data.image },
										]}
									>
										{
											post.data.image && (
												<ArticleHeroImage
													src={post.data.image}
													alt={heroImageAlt}
													{...heroCaptionProps}
												/>
											)
										}

										<div class="articulo__hero-cabecera">
											<div class="articulo__rubro">
												<p class="articulo__eyebrow">{sideLabel}</p>
												<span class="articulo__rubro-separador" aria-hidden="true" />
												<time
													class="articulo__fecha"
													datetime={post.data.pubDate.toISOString()}
												>
													{formattedDate}
												</time>
											</div>

											<h1 class="articulo__titulo">{post.data.title}</h1>
											{
												post.data.subtitle && (
													<p class="articulo__subtitulo articulo__subtitulo--compacto">
														{post.data.subtitle}
													</p>
												)
											}
											<p class="articulo__bajada">{post.data.summary}</p>

											<div class="articulo__meta">
												<span class="articulo__autor">
													por <em>{post.data.author}</em>
												</span>
												<span class="articulo__stat" aria-label="Tiempo de lectura">
													<svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
														<circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2" />
														<path d="M12 7v5l3 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
													</svg>
													{minutes} min de lectura
												</span>
												<span class="articulo__stat" aria-label="Cantidad de palabras">
													<svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
														<path d="M5 5h14v14H5z" stroke="currentColor" stroke-width="2" />
														<path d="M9 9h6M9 13h6M9 17h4" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
													</svg>
													{formatWordCount(words)} palabras aprox.
												</span>
											</div>
										</div>

										<div class="articulo__deco" aria-hidden="true">
											<span class="articulo__deco-circulo" />
											<span class="articulo__deco-circulo" />
											<span class="articulo__deco-circulo" />
										</div>
									</div>
								</header>
							)
						}

						<div class="articulo__cuerpo">
							<div class="articulo__contenido">
								<Content components={revistaMdxComponents} />
							</div>
							<div class="articulo__firma">
								<p>Escrito por <strong>{post.data.author}</strong> para Cosmopolitican, tu revista con clase.</p>
							</div>
							{
								post.data.originalUrl && (
									<ArticleOriginalLink url={post.data.originalUrl} />
								)
							}
						</div>

						<RelatedArticles
							articles={relatedArticles}
							heading={relatedHeading}
						/>
							</div>
						</div>
					</div>
				</article>
			</>
		)
	}
</ElegantLayout>
