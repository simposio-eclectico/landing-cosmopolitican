---
import { getCollection, render } from "astro:content";
import ArticleSideLabel from "@components/revista/ArticleSideLabel.astro";
import VideoArticle from "@components/revista/VideoArticle.astro";
import RelatedArticles from "@components/revista/RelatedArticles.astro";
import ElegantLayout from "@layouts/ElegantLayout.astro";
import { SITE_NAME, MENU_SECTION_LABELS } from "@consts";
import { formatWordCount, getReadingMeta } from "@lib/articuloMeta";
import { getRelatedArticles } from "@lib/revistaMenu";
import "@styles/articulo.css";

export async function getStaticPaths() {
	const revistas = await getCollection("revista");
	return revistas.map((post) => ({
		params: { slug: post.data.slug || post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);
const revistas = await getCollection("revista");
const relatedArticles = getRelatedArticles(revistas, post.id, post.data.issueNumber);
const { minutes, words } = getReadingMeta(post.body ?? "");

const formattedDate = post.data.pubDate.toLocaleDateString("es-ES", {
	year: "numeric",
	month: "long",
	day: "numeric",
});

const sideLabel = MENU_SECTION_LABELS[post.data.menuSection].toUpperCase();
const relatedHeading = `Más ${MENU_SECTION_LABELS[post.data.menuSection].toLowerCase()} que te pueden interesar`;
const isVideoArticle = post.data.format === "video";
---

<ElegantLayout title={`${post.data.title} - ${SITE_NAME}`} bare>
	{
		isVideoArticle ? (
			<VideoArticle post={post} relatedArticles={relatedArticles}>
				<Content />
			</VideoArticle>
		) : (
			<>
				<ArticleSideLabel label={sideLabel} />

				<article class="articulo">
					<div class="articulo__contenedor contenedor">
						<header class="articulo__hero">
							<div
								class:list={[
									"articulo__hero-grid",
									{ "articulo__hero-grid--sin-imagen": !post.data.image },
								]}
							>
								{
									post.data.image && (
										<figure class="articulo__hero-imagen">
											<img
												src={post.data.image}
												alt={post.data.imageAlt ?? post.data.title}
												width="560"
												height="420"
											/>
										</figure>
									)
								}

								<div class="articulo__hero-cabecera">
									<div class="articulo__rubro">
										<p class="articulo__eyebrow">{sideLabel}</p>
										<span class="articulo__rubro-separador" aria-hidden="true" />
										<time
											class="articulo__fecha"
											datetime={post.data.pubDate.toISOString()}
										>
											{formattedDate}
										</time>
									</div>

									<h1 class="articulo__titulo">{post.data.title}</h1>
									<p class="articulo__bajada">{post.data.summary}</p>

									<div class="articulo__meta">
										<span class="articulo__autor">
											por <em>{post.data.author}</em>
										</span>
										<span class="articulo__stat" aria-label="Tiempo de lectura">
											<svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
												<circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2" />
												<path d="M12 7v5l3 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
											</svg>
											{minutes} min de lectura
										</span>
										<span class="articulo__stat" aria-label="Cantidad de palabras">
											<svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
												<path d="M5 5h14v14H5z" stroke="currentColor" stroke-width="2" />
												<path d="M9 9h6M9 13h6M9 17h4" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
											</svg>
											{formatWordCount(words)} palabras aprox.
										</span>
									</div>
								</div>

								<div class="articulo__deco" aria-hidden="true">
									<span class="articulo__deco-circulo" />
									<span class="articulo__deco-circulo" />
									<span class="articulo__deco-circulo" />
								</div>
							</div>
						</header>

						<div class="articulo__cuerpo">
							<div class="articulo__contenido">
								<Content />
							</div>
						</div>

						<RelatedArticles
							articles={relatedArticles}
							heading={relatedHeading}
						/>
					</div>
				</article>
			</>
		)
	}
</ElegantLayout>
