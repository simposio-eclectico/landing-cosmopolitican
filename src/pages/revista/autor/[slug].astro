---
import ElegantLayout from "@layouts/ElegantLayout.astro";
import ArticleSummary from "@components/revista/ArticleSummary.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { SITE_NAME } from "@consts";

export async function getStaticPaths() {
	const revistas = await getCollection("revista");

	// Extraer autores únicos y crear slugs
	const authorMap = new Map();
	revistas.forEach((article) => {
		const author = article.data.author || SITE_NAME;
		if (!authorMap.has(author)) {
			authorMap.set(author, {
				name: author,
				slug: author
					.toLowerCase()
					.normalize("NFD")
					.replace(/[̀-ͯ]/g, "")
					.replace(/[^\w\s-]/g, "")
					.trim()
					.replace(/\s+/g, "-"),
			});
		}
	});

	return Array.from(authorMap.values()).map((author) => ({
		params: { slug: author.slug },
		props: { authorName: author.name },
	}));
}

interface Props {
	authorName: string;
}

const { authorName } = Astro.props;

const revistas = await getCollection("revista");
const authorArticles = revistas
	.filter((article) => {
		const author = article.data.author || SITE_NAME;
		return author === authorName;
	})
	.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const title = `Artículos de ${authorName} — ${SITE_NAME}`;
const description = `Lee todos los artículos escritos por ${authorName} en ${SITE_NAME}`;
---

<ElegantLayout {title} {description}>
	<div class="archivo">
		<header class="archivo__header">
			<h1 class="archivo__titulo">{authorName}</h1>
			<p class="archivo__bajada">
				{authorArticles.length} artículo{authorArticles.length !== 1 ? "s" : ""}
			</p>
		</header>

		{
			authorArticles.length > 0 && (
				<div class="archivo__grid">
					{
						authorArticles.map((post) => (
							<article class="archivo__card">
								<a
									href={`/revista/${post.data.slug || post.id}`}
									class="archivo__card-link"
								>
									{
										post.data.image && (
											<div class="archivo__card-image-wrap">
												<Image
													src={post.data.image}
													alt={post.data.imageAlt ?? post.data.title}
													class="archivo__card-image"
													loading="lazy"
													width={400}
													height={250}
												/>
											</div>
										)
									}
									<div class="archivo__card-body">
										<time
											class="archivo__card-date"
											datetime={post.data.pubDate.toISOString()}
										>
											{
												post.data.pubDate.toLocaleDateString("es-ES", {
													year: "numeric",
													month: "long",
													day: "numeric",
												})
											}
										</time>
										<h2 class="archivo__card-title">{post.data.title}</h2>
										{post.data.section && (
											<p class="archivo__card-section">{post.data.section}</p>
										)}
										<ArticleSummary
											summary={post.data.summary}
											class="archivo__card-summary"
										/>
									</div>
								</a>
							</article>
						))
					}
				</div>
			)
		}
	</div>
</ElegantLayout>

<style>
	.archivo {
		max-width: var(--contenedor-max);
		margin: 0 auto;
		padding: 0 var(--padding-lateral);
	}

	.archivo__header {
		margin-bottom: 3rem;
		padding-bottom: 2rem;
		border-bottom: 1px solid var(--color-separador);
	}

	.archivo__titulo {
		font-size: clamp(28px, 4vw, 40px);
		font-weight: 900;
		color: var(--color-magenta);
		margin-bottom: 0.5rem;
	}

	.archivo__bajada {
		font-size: 16px;
		color: var(--color-gris-txt);
		margin: 0;
	}

	.archivo__grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: var(--gap-cards);
	}

	.archivo__card-link {
		display: block;
	}

	.archivo__card-image-wrap {
		overflow: hidden;
	}

	.archivo__card-image {
		width: 100%;
		aspect-ratio: 16 / 10;
		object-fit: cover;
		display: block;
	}

	.archivo__card-link:hover .archivo__card-image {
		transform: scale(1.03);
		transition: transform 0.3s ease;
	}

	.archivo__card-body {
		margin-top: 12px;
	}

	.archivo__card-date {
		display: block;
		font-size: var(--size-fecha);
		color: var(--color-gris-fecha);
		margin-bottom: 6px;
	}

	.archivo__card-title {
		font-size: var(--size-card-titulo);
		font-weight: 700;
		line-height: 1.25;
		color: var(--color-magenta);
		margin-bottom: 6px;
		transition: color 0.15s ease;
	}

	.archivo__card-link:hover .archivo__card-title {
		color: var(--color-magenta-hover);
	}

	.archivo__card-section {
		font-size: 13px;
		margin: 0 0 8px;
		color: var(--color-gris-txt);
		font-weight: 600;
	}

	.archivo__card-summary {
		font-size: 14px;
		line-height: 1.6;
		margin: 0;
	}
</style>
