---
import { getCollection } from "astro:content";
import { getLeadArticle } from "@lib/revistaMenu";

const revistas = await getCollection("revista");
const leadArticle = getLeadArticle(revistas);
const slug = leadArticle
	? leadArticle.data.slug || leadArticle.id
	: "numeros";

return Astro.redirect(`/revista/${slug}`, 307);
---
