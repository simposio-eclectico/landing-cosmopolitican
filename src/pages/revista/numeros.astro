---
import ElegantLayout from "@layouts/ElegantLayout.astro";
import { getCollection } from "astro:content";
import { CATEGORIES } from "@consts";
import { getSectionsByCategory } from "@lib/revistaMenu";

const revistas = await getCollection("revista");
const sortedRevistas = revistas.sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const categoryKeys = Object.keys(CATEGORIES) as Array<keyof typeof CATEGORIES>;
const sectionsByCategory = getSectionsByCategory(revistas);
---

<ElegantLayout title="Revista - Cosmopolitican">
  <div class="revista-header">
    <div class="block-header" style="transform: rotate(var(--c-rotate));">
      ARCHIVOS & EDICIONES
    </div>

    <div class="filter-container">
      <div class="filter-categories">
        <button class="filter-btn category-btn active" data-category="all"
          >Todos</button
        >
        {
          categoryKeys.map((key) => (
            <button
              class="filter-btn category-btn"
              data-category={CATEGORIES[key]}
            >
              {CATEGORIES[key]}
            </button>
          ))
        }
      </div>

      <div class="filter-sections" style="display: none;">
        <!-- Sub-sections will be populated by JS when a category is clicked -->
      </div>
    </div>

    <div class="archive-grid">
      {
        sortedRevistas.map((post) => (
          <article
            class={`issue-card ${post.data.theme !== "default" ? post.data.theme : ""}`.trim()}
            data-category={post.data.category || ""}
            data-section={post.data.section || ""}
            data-issue-slug={post.data.slug || post.id}
            data-issue-title={post.data.title}
            data-issue-number={post.data.issueNumber}
          >
            <a
              href={`/revista/${post.data.slug || post.id}`}
              class="issue-link"
            >
              <h2>{post.data.title}</h2>
            </a>
            <div class="issue-excerpt">
              {
                post.data.image && (
                  <img
                    src={post.data.image}
                    alt={post.data.imageAlt ?? post.data.title}
                    class="issue-image"
                    loading="lazy"
                    width="140"
                    height="140"
                  />
                )
              }
              <p>{post.data.summary}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</ElegantLayout>

<style>
  .revista-header {
    max-width: 1200px;
    margin: 0 auto;
  }

  .filter-container {
    margin-top: 3rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: center;
  }

  .filter-categories,
  .filter-sections {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }

  .filter-btn {
    background: transparent;
    color: var(--c-black);
    border: var(--c-border-thick);
    padding: 0.5rem 1.5rem;
    font-family: var(--c-font-display);
    font-weight: 700;
    font-size: 1.3rem;
    text-transform: uppercase;
    cursor: pointer;
    box-shadow: var(--c-shadow-pop);
    transition: all 0.2s ease;
  }

  :global(.theme-elegant) .filter-btn {
    box-shadow: none;
    border-width: 1px;
  }

  .filter-btn:hover {
    transform: translate(-3px, -3px);
    box-shadow: 8px 8px 0 var(--c-black);
  }

  .filter-btn.active {
    background-color: var(--c-black);
    color: var(--c-bg);
  }

  .filter-sections .filter-btn {
    font-size: 1.1rem;
    font-weight: 600;
    border-width: 3px;
    box-shadow: 4px 4px 0 var(--c-black);
    padding: 0.4rem 1.2rem;
  }

  .filter-sections .filter-btn:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--c-black);
  }

  .archive-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 3rem;
    margin-top: 3rem;
  }

  .issue-card {
    background-color: var(--c-bg);
    border: var(--c-border-thick);
    padding: 2.5rem;
    box-shadow: var(--c-shadow-pop);
    display: flex;
    flex-direction: column;
    transition:
      transform 0.2s,
      box-shadow 0.2s;
    position: relative;
    overflow: hidden;
  }

  :global(.theme-elegant) .issue-card::before {
    display: none;
  }

  .issue-card:hover {
    transform: translate(-4px, -4px);
    box-shadow: 16px 16px 0 var(--c-hot);
  }

  .issue-card:hover a h2 {
    transition: .125s color;
    color: var(--c-hot);
  }

  .issue-card.featured {
    grid-column: 1 / -1;
    box-shadow: var(--c-shadow-pop);
    border: var(--c-border-thick);
  }

  :global(.theme-elegant) .issue-card.featured {
    background-color: var(--c-bg);
    color: var(--c-black);
    box-shadow: none;
    border-width: 1px;
  }

  .issue-card.featured::before {
    content: "";
    position: absolute;
    top: -20px;
    right: -20px;
    width: 60px;
    height: 60px;
    background-color: var(--c-hot);
    transform: rotate(45deg);
    border-bottom: var(--c-border-thick);
  }

  .issue-card.dark {
    background-color: var(--c-black);
    color: var(--c-bg);
    border-color: var(--c-hot);
    box-shadow: 12px 12px 0 var(--c-hot);
  }

  .issue-card.dark::before {
    background-color: var(--c-bg);
  }

  .issue-card h2 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    border-bottom: var(--c-border-thick);
    border-width: 2px;
    padding-bottom: 0.5rem;
    line-height: 1.1;
  }

  .issue-card.featured h2 {
    font-size: 4rem;
  }

  .issue-excerpt {
    display: flex;
    gap: 1.25rem;
    flex: 1;
    align-items: flex-start;
  }

  .issue-image {
    width: 140px;
    height: 140px;
    object-fit: cover;
    border: var(--c-border-thick);
    box-shadow: var(--c-shadow-pop);
    flex-shrink: 0;
  }

  :global(.theme-elegant) .issue-image {
    box-shadow: none;
    border-width: 1px;
  }

  .issue-excerpt p {
    flex: 1;
    font-size: 1.2rem;
    margin: 0;
  }

  .issue-card.featured .issue-image {
    width: 200px;
    height: 200px;
  }

  .issue-card .cta-button {
    align-self: flex-start;
    margin-top: auto;
  }

  .issue-link {
    transition: .125s color;
    text-decoration: none; align-self: flex-start; margin-top: auto; display: inline-block;
  }
</style>

<script define:vars={{ sectionsByCategory }}>
  document.addEventListener("DOMContentLoaded", () => {
    const categoryBtns = document.querySelectorAll(".category-btn");
    const sectionsContainer = document.querySelector(".filter-sections");
    const issueCards = document.querySelectorAll(".issue-card");

    let currentCategory = "all";
    let currentSection = "all";

    function renderSections(category) {
      const sections = sectionsByCategory[category];

      if (category === "all" || !sections?.length) {
        sectionsContainer.style.display = "none";
        return;
      }

      sectionsContainer.style.display = "flex";
      sectionsContainer.innerHTML = `<button class="filter-btn section-btn active" data-section="all">Todas</button>`;

      sections.forEach((sec) => {
        const btn = document.createElement("button");
        btn.className = "filter-btn section-btn";
        btn.dataset.section = sec;
        btn.textContent = sec;
        sectionsContainer.appendChild(btn);
      });

      // Bind events to new section buttons
      document.querySelectorAll(".section-btn").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          document
            .querySelectorAll(".section-btn")
            .forEach((b) => b.classList.remove("active"));
          e.target.classList.add("active");
          currentSection = e.target.dataset.section;
          filterCards();
        });
      });
    }

    function filterCards() {
      issueCards.forEach((card) => {
        const cardCat = card.dataset.category;
        const cardSec = card.dataset.section;

        const categoryMatch =
          currentCategory === "all" || cardCat === currentCategory;
        const sectionMatch =
          currentSection === "all" || cardSec === currentSection;

        if (categoryMatch && sectionMatch) {
          card.style.display = "flex";
        } else {
          card.style.display = "none";
        }
      });
    }

    categoryBtns.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        document
          .querySelectorAll(".category-btn")
          .forEach((b) => b.classList.remove("active"));
        e.target.classList.add("active");
        currentCategory = e.target.dataset.category;
        currentSection = "all";
        renderSections(currentCategory);
        filterCards();
      });
    });
  });
</script>
